<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Interop types are spelled the way the Win32 headers spell them. -->
    <NoWarn>$(NoWarn);CA1707;CA1711;CA1716;CA1720;CA1724;CA1028;CA1008;CA1027;CA1034;CA1815;CA1819;CA1305;CA1310;CA1307;CA1309;CA1848;CA1031;CA2101;CA1838;CA5392;CA1305;CA1303;CA1822;CA1056;CA1054;CA1062;CA1002;CA2227;CA1515;CA1805;CA1860;CA1865;CA1866;CA1847;CA2201</NoWarn>
  </PropertyGroup>
</Project>
