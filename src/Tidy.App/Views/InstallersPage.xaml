<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tidy.App.Views.InstallersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Tidy.App.ViewModels"
    xmlns:core="using:Tidy.Core.Deletion">
    <Grid Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Installers" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{x:Bind Vm.Summary, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button Style="{StaticResource SecondaryButtonStyle}" Click="OnScan" IsEnabled="{x:Bind Not(Vm.IsBusy), Mode=OneWay}"
                        ToolTipService.ToolTip="Scan again (Ctrl+R)" AutomationProperties.Name="Scan">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="R" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Grid Width="16" Height="16">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" Visibility="{x:Bind Collapsed(Vm.IsScanning), Mode=OneWay}" />
                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind Vm.IsScanning, Mode=OneWay}"
                                          Foreground="{ThemeResource TextPrimaryBrush}" />
                        </Grid>
                        <TextBlock Text="Scan" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButtonStyle}" Click="OnRecycle" IsEnabled="{x:Bind Vm.CanRecycle, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind Vm.RecycleButtonText, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Grid Width="16" Height="16">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" Visibility="{x:Bind Collapsed(Vm.IsCleaning), Mode=OneWay}" />
                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind Vm.IsCleaning, Mode=OneWay}"
                                          Foreground="{ThemeResource OnActionPrimaryBrush}" />
                        </Grid>
                        <TextBlock Text="{x:Bind Vm.RecycleButtonText, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,20,0,0" ColumnSpacing="8" Visibility="{x:Bind Vm.HasInstallers, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="260" MaxWidth="360" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox PlaceholderText="Search by file, app or folder" QueryIcon="Find"
                            Text="{x:Bind Vm.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="Search installers" />
            <ComboBox Grid.Column="2" x:Name="SortBox" MinWidth="130" SelectionChanged="OnSortChanged" AutomationProperties.Name="Sort by" />
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,14,0,10" Spacing="4" Visibility="{x:Bind Vm.HasInstallers, Mode=OneWay}">
            <CheckBox x:Name="SelectAll" Content="Select all" MinWidth="0" IsChecked="{x:Bind Vm.SelectAllState, Mode=OneWay}" Click="OnSelectAll" />
            <TextBlock Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap"
                       Text="Only the installer files go to the Recycle Bin. The apps stay installed." />
        </StackPanel>

        <InfoBar Grid.Row="3" Margin="0,0,0,10" IsOpen="{x:Bind Vm.IsResultOpen, Mode=TwoWay}"
                 Title="{x:Bind Vm.ResultTitle, Mode=OneWay}" Message="{x:Bind Vm.ResultMessage, Mode=OneWay}"
                 Severity="{x:Bind ResultSeverity(Vm.ResultHasFailures), Mode=OneWay}">
            <InfoBar.ActionButton>
                <HyperlinkButton Content="Open Recycle Bin" Click="OnOpenRecycleBin" />
            </InfoBar.ActionButton>
            <ItemsControl ItemsSource="{x:Bind Vm.ResultFailures}" Margin="0,0,0,12" Visibility="{x:Bind Vm.ResultHasFailures, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:CleanFailure">
                        <StackPanel Margin="0,2">
                            <TextBlock Text="{x:Bind Path}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Reason}" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </InfoBar>

        <ListView Grid.Row="4" ItemsSource="{x:Bind Vm.Visible}" SelectionMode="None" IsItemClickEnabled="True"
                  ItemClick="OnItemClick" ContainerContentChanging="OnContainerContentChanging"
                  Padding="0,0,0,24" Margin="-12,0,-12,0" ItemContainerStyle="{StaticResource CardListViewItemStyle}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:InstallerViewModel">
                    <Grid ColumnSpacing="14" Background="Transparent" ToolTipService.ToolTip="{x:Bind Path}" DoubleTapped="OnRowDoubleTapped">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Show in File Explorer" Tag="{x:Bind}" Click="OnShowInExplorer">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B7;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Copy path" Tag="{x:Bind}" Click="OnCopyPath">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=OneWay}" Tag="{x:Bind}" Click="OnRowCheckClick" MinWidth="0" Padding="0"
                                  VerticalAlignment="Center" AutomationProperties.Name="{x:Bind Name}" />
                        <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8" Background="{ThemeResource FillSecondaryBrush}">
                            <Grid>
                                <FontIcon Glyph="&#xE896;" FontSize="18" Foreground="{ThemeResource TextSecondaryBrush}" Visibility="{x:Bind HasNoIcon, Mode=OneWay}" />
                                <Image Source="{x:Bind Icon, Mode=OneWay}" Width="26" Height="26" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Style="{StaticResource CaptionSecondaryStyle}" TextTrimming="CharacterEllipsis">
                                <Run Text="{x:Bind InstalledText}" /><Run Text=" · " /><Run Text="{x:Bind Subtitle}" />
                            </TextBlock>
                            <TextBlock Text="{x:Bind AgeText}" Visibility="{x:Bind HasAgeText}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="6" MinWidth="110">
                            <TextBlock Text="{x:Bind SizeText}" Style="{StaticResource SizeTextStyle}" />
                            <Border HorizontalAlignment="Right" Padding="7,2" CornerRadius="4" Visibility="{x:Bind IsNewer}"
                                    Background="{ThemeResource StatusCheckFillBrush}">
                                <TextBlock Text="Check First" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                                           Foreground="{ThemeResource StatusCheckTextBrush}" />
                            </Border>
                            <TextBlock Text="{x:Bind ModifiedText}" Visibility="{x:Bind ShowModified}" Style="{StaticResource CaptionSecondaryStyle}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="1" Grid.RowSpan="4" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                    Visibility="{x:Bind Vm.IsFirstScan, Mode=OneWay}">
            <ProgressRing IsActive="{x:Bind Vm.IsFirstScan, Mode=OneWay}" Width="32" Height="32" />
            <TextBlock Text="Matching installers in your folders to the apps you have…" Style="{StaticResource SecondaryTextStyle}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.RowSpan="4" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="460"
                    Visibility="{x:Bind Vm.IsEmpty, Mode=OneWay}">
            <FontIcon Glyph="&#xE73E;" FontSize="32" Foreground="{ThemeResource StatusSafeTextBrush}" Margin="0,0,0,8" />
            <TextBlock Text="No leftover installers" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}" />
            <TextBlock Text="None of the installers in Documents, Desktop, Downloads, Videos, Music or Pictures are for an app you already have. Installers for anything else are left out."
                       Style="{StaticResource SecondaryTextStyle}" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Grid.Row="4" Text="No installers match your search." Style="{StaticResource SecondaryTextStyle}"
                   HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="{x:Bind Vm.NothingMatches, Mode=OneWay}" />
    </Grid>
</Page>
