<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tidy.App.Views.WindowsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Tidy.App.ViewModels"
    xmlns:core="using:Tidy.Core.Deletion">
    <Grid Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Windows" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{x:Bind Vm.Summary, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button Style="{StaticResource SecondaryButtonStyle}" Click="OnCheck" IsEnabled="{x:Bind Not(Vm.IsBusy), Mode=OneWay}"
                        ToolTipService.ToolTip="Windows asks for administrator permission" AutomationProperties.Name="{x:Bind Vm.CheckButtonText, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Grid Width="16" Height="16">
                            <FontIcon Glyph="&#xEA18;" FontSize="14" Visibility="{x:Bind Collapsed(Vm.IsChecking), Mode=OneWay}" />
                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind Vm.IsChecking, Mode=OneWay}"
                                          Foreground="{ThemeResource TextPrimaryBrush}" />
                        </Grid>
                        <TextBlock Text="{x:Bind Vm.CheckButtonText, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButtonStyle}" Click="OnClean" IsEnabled="{x:Bind Vm.CanClean, Mode=OneWay}"
                        ToolTipService.ToolTip="Windows asks for administrator permission" AutomationProperties.Name="{x:Bind Vm.CleanButtonText, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Grid Width="16" Height="16">
                            <FontIcon Glyph="&#xEA18;" FontSize="14" Visibility="{x:Bind Collapsed(Vm.IsCleaning), Mode=OneWay}" />
                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind Vm.IsCleaning, Mode=OneWay}"
                                          Foreground="{ThemeResource OnActionPrimaryBrush}" />
                        </Grid>
                        <TextBlock Text="{x:Bind Vm.CleanButtonText, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Margin="0,20,0,14" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"
                   Text="Windows keeps update leftovers, your previous version of Windows and crash dumps in its own folders. Tidy has Windows' own Disk Cleanup measure and remove them, so checking and cleaning both need administrator permission. What's cleaned here can't go to the Recycle Bin." />

        <InfoBar Grid.Row="2" Margin="0,0,0,10" IsOpen="{x:Bind Vm.IsResultOpen, Mode=TwoWay}"
                 Title="{x:Bind Vm.ResultTitle, Mode=OneWay}" Message="{x:Bind Vm.ResultMessage, Mode=OneWay}"
                 Severity="{x:Bind ResultSeverity(Vm.ResultHasFailures), Mode=OneWay}">
            <ItemsControl ItemsSource="{x:Bind Vm.ResultFailures}" Margin="0,0,0,12" Visibility="{x:Bind Vm.ResultHasFailures, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:CleanFailure">
                        <StackPanel Margin="0,2">
                            <TextBlock Text="{x:Bind Path}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Reason}" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </InfoBar>

        <ListView Grid.Row="3" ItemsSource="{x:Bind Vm.Items}" SelectionMode="None" IsItemClickEnabled="True"
                  ItemClick="OnItemClick" Padding="0,0,0,24" Margin="-12,0,-12,0" ItemContainerStyle="{StaticResource CardListViewItemStyle}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:WindowsCleanupItemViewModel">
                    <Grid ColumnSpacing="14" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=OneWay}" IsEnabled="{x:Bind CanSelect, Mode=OneWay}" Tag="{x:Bind}" Click="OnRowCheckClick"
                                  MinWidth="0" Padding="0" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind Name}" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Text="{x:Bind Explanation}" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center" MinWidth="110">
                            <Grid HorizontalAlignment="Right">
                                <TextBlock Text="{x:Bind SizeText, Mode=OneWay}" Visibility="{x:Bind HasSize, Mode=OneWay}" Style="{StaticResource SizeTextStyle}" />
                                <TextBlock Text="{x:Bind NoteText, Mode=OneWay}" Visibility="{x:Bind ShowsNote, Mode=OneWay}" Style="{StaticResource CaptionSecondaryStyle}" />
                                <ProgressRing IsActive="{x:Bind IsWorking, Mode=OneWay}" Width="16" Height="16" />
                            </Grid>
                            <Border HorizontalAlignment="Right" Padding="7,2" CornerRadius="4" Visibility="{x:Bind IsSafe}" Background="{ThemeResource StatusSafeFillBrush}">
                                <TextBlock Text="Safe to Clean" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource StatusSafeTextBrush}" />
                            </Border>
                            <Border HorizontalAlignment="Right" Padding="7,2" CornerRadius="4" Visibility="{x:Bind IsCheckFirst}" Background="{ThemeResource StatusCheckFillBrush}">
                                <TextBlock Text="Check First" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource StatusCheckTextBrush}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
