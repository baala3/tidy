<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tidy.App.Views.VirtualDisksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Tidy.App.ViewModels"
    xmlns:core="using:Tidy.Core.Deletion">
    <Grid Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="WSL &amp; Docker" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{x:Bind Vm.Summary, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button Style="{StaticResource SecondaryButtonStyle}" Click="OnScan" IsEnabled="{x:Bind Not(Vm.IsBusy), Mode=OneWay}"
                        ToolTipService.ToolTip="Scan again (Ctrl+R)" AutomationProperties.Name="Scan">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="R" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Grid Width="16" Height="16">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" Visibility="{x:Bind Collapsed(Vm.IsScanning), Mode=OneWay}" />
                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind Vm.IsScanning, Mode=OneWay}"
                                          Foreground="{ThemeResource TextPrimaryBrush}" />
                        </Grid>
                        <TextBlock Text="Scan" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButtonStyle}" Click="OnCompact" IsEnabled="{x:Bind Vm.CanCompact, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind Vm.CompactButtonText, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Grid Width="16" Height="16">
                            <FontIcon Glyph="&#xE73F;" FontSize="14" Visibility="{x:Bind Collapsed(Vm.IsCompacting), Mode=OneWay}" />
                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind Vm.IsCompacting, Mode=OneWay}"
                                          Foreground="{ThemeResource OnActionPrimaryBrush}" />
                        </Grid>
                        <TextBlock Text="{x:Bind Vm.CompactButtonText, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Margin="0,20,0,14" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"
                   Text="Linux distros and Docker keep their files in disk images that grow as they're used and never shrink by themselves. Compacting gives back the space their files no longer use. Nothing inside changes." />

        <InfoBar Grid.Row="2" Margin="0,0,0,10" IsOpen="{x:Bind Vm.IsResultOpen, Mode=TwoWay}"
                 Title="{x:Bind Vm.ResultTitle, Mode=OneWay}" Message="{x:Bind Vm.ResultMessage, Mode=OneWay}"
                 Severity="{x:Bind ResultSeverity(Vm.ResultHasFailures), Mode=OneWay}">
            <ItemsControl ItemsSource="{x:Bind Vm.ResultFailures}" Margin="0,0,0,12" Visibility="{x:Bind Vm.ResultHasFailures, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:CleanFailure">
                        <StackPanel Margin="0,2">
                            <TextBlock Text="{x:Bind Path}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Reason}" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </InfoBar>

        <ListView Grid.Row="3" ItemsSource="{x:Bind Vm.Disks}" SelectionMode="None" IsItemClickEnabled="True"
                  ItemClick="OnItemClick" Padding="0,0,0,24" Margin="-12,0,-12,0" ItemContainerStyle="{StaticResource CardListViewItemStyle}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:VirtualDiskViewModel">
                    <Grid ColumnSpacing="14" Background="Transparent" ToolTipService.ToolTip="{x:Bind Disk.Path}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Show in File Explorer" Tag="{x:Bind}" Click="OnShowInExplorer">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B7;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=OneWay}" IsEnabled="{x:Bind CanSelect}" Tag="{x:Bind}" Click="OnRowCheckClick"
                                  MinWidth="0" Padding="0" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind Name}" />
                        <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8" Background="{ThemeResource FillSecondaryBrush}">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionSecondaryStyle}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="6" VerticalAlignment="Center" MinWidth="96">
                            <TextBlock Text="{x:Bind SizeText}" Visibility="{x:Bind HasKnownSize}" Style="{StaticResource SizeTextStyle}" />
                            <TextBlock Text="Known after a trim" Visibility="{x:Bind SizeAfterTrim}" Style="{StaticResource CaptionSecondaryStyle}" HorizontalAlignment="Right" />
                            <Border HorizontalAlignment="Right" Padding="7,2" CornerRadius="4" Visibility="{x:Bind CanSelect}"
                                    Background="{ThemeResource StatusSafeFillBrush}">
                                <TextBlock Text="Safe to Compact" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                                           Foreground="{ThemeResource StatusSafeTextBrush}" />
                            </Border>
                            <TextBlock Text="Already compact" Visibility="{x:Bind IsCompact}" Style="{StaticResource CaptionSecondaryStyle}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
