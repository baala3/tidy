<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tidy.App.Views.OneDrivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Tidy.App.ViewModels"
    xmlns:core="using:Tidy.Core.Deletion">
    <Grid Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="OneDrive" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{x:Bind Vm.Summary, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button Style="{StaticResource SecondaryButtonStyle}" Click="OnScan" IsEnabled="{x:Bind Not(Vm.IsBusy), Mode=OneWay}"
                        ToolTipService.ToolTip="Scan again (Ctrl+R)" AutomationProperties.Name="Scan">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="R" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Grid Width="16" Height="16">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" Visibility="{x:Bind Collapsed(Vm.IsScanning), Mode=OneWay}" />
                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind Vm.IsScanning, Mode=OneWay}"
                                          Foreground="{ThemeResource TextPrimaryBrush}" />
                        </Grid>
                        <TextBlock Text="Scan" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButtonStyle}" Click="OnFreeUp" IsEnabled="{x:Bind Vm.CanAct, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind Vm.FreeButtonText, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Grid Width="16" Height="16">
                            <FontIcon Glyph="&#xE753;" FontSize="14" Visibility="{x:Bind Collapsed(Vm.IsWorking), Mode=OneWay}" />
                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind Vm.IsWorking, Mode=OneWay}"
                                          Foreground="{ThemeResource OnActionPrimaryBrush}" />
                        </Grid>
                        <TextBlock Text="{x:Bind Vm.FreeButtonText, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,20,0,0" ColumnSpacing="8" Visibility="{x:Bind Vm.HasFiles, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="260" MaxWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox PlaceholderText="Search by name or folder" QueryIcon="Find"
                            Text="{x:Bind Vm.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="Search OneDrive files" />
            <ComboBox Grid.Column="1" x:Name="SizeBox" MinWidth="140" SelectionChanged="OnSizeChanged" AutomationProperties.Name="Minimum size" />
            <ComboBox Grid.Column="2" x:Name="AgeBox" MinWidth="170" SelectionChanged="OnAgeChanged" AutomationProperties.Name="Last modified" />
            <ComboBox Grid.Column="4" x:Name="SortBox" MinWidth="120" SelectionChanged="OnSortChanged" AutomationProperties.Name="Sort by" />
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,14,0,10" Spacing="12">
            <InfoBar IsOpen="{x:Bind Vm.ShowNotRunning, Mode=OneWay}" IsClosable="False" Severity="Warning"
                     Title="OneDrive isn't running"
                     Message="Start OneDrive first. An online-only file needs it to download again when you open it." />
            <ItemsControl ItemsSource="{x:Bind Vm.Chips}" Visibility="{x:Bind Vm.HasFiles, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:KindChip">
                        <ToggleButton Style="{StaticResource ChipStyle}" Content="{x:Bind Text}" IsChecked="{x:Bind IsActive, Mode=OneWay}"
                                      Tag="{x:Bind}" Click="OnChipClick" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Spacing="4" Visibility="{x:Bind Vm.HasFiles, Mode=OneWay}">
                <CheckBox x:Name="SelectShown" Content="Select all shown" MinWidth="0" IsChecked="{x:Bind Vm.SelectShownState, Mode=OneWay}" Click="OnSelectShown" />
                <TextBlock Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap"
                           Text="Freeing up space keeps each file in OneDrive and in File Explorer. It downloads again when you open it, so you need to be online then." />
            </StackPanel>
        </StackPanel>

        <InfoBar Grid.Row="3" Margin="0,0,0,10" IsOpen="{x:Bind Vm.IsResultOpen, Mode=TwoWay}"
                 Title="{x:Bind Vm.ResultTitle, Mode=OneWay}" Message="{x:Bind Vm.ResultMessage, Mode=OneWay}"
                 Severity="{x:Bind ResultSeverity(Vm.ResultHasFailures), Mode=OneWay}">
            <ItemsControl ItemsSource="{x:Bind Vm.ResultFailures}" Margin="0,0,0,12" Visibility="{x:Bind Vm.ResultHasFailures, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:CleanFailure">
                        <StackPanel Margin="0,2">
                            <TextBlock Text="{x:Bind Path}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Reason}" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </InfoBar>

        <ListView Grid.Row="4" ItemsSource="{x:Bind Vm.Visible}" SelectionMode="None" IsItemClickEnabled="True"
                  ItemClick="OnItemClick" Padding="0,0,0,24" Margin="-12,0,-12,0"
                  ItemContainerStyle="{StaticResource CardListViewItemStyle}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:LargeFileViewModel">
                    <Grid ColumnSpacing="14" Background="Transparent" ToolTipService.ToolTip="{x:Bind Path}" DoubleTapped="OnRowDoubleTapped">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Show in File Explorer" Tag="{x:Bind}" Click="OnShowInExplorer">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B7;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Copy path" Tag="{x:Bind}" Click="OnCopyPath">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=OneWay}" Tag="{x:Bind}" Click="OnRowCheckClick" MinWidth="0" Padding="0" VerticalAlignment="Center"
                                  AutomationProperties.Name="{x:Bind Name}" />
                        <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8" Background="{ThemeResource FillSecondaryBrush}">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Text="{x:Bind FolderText}" Style="{StaticResource CaptionSecondaryStyle}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2" MinWidth="110">
                            <TextBlock Text="{x:Bind SizeText}" Style="{StaticResource SizeTextStyle}" />
                            <TextBlock Text="{x:Bind ModifiedText}" Style="{StaticResource CaptionSecondaryStyle}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="1" Grid.RowSpan="4" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                    Visibility="{x:Bind Vm.IsFirstScan, Mode=OneWay}">
            <ProgressRing IsActive="{x:Bind Vm.IsFirstScan, Mode=OneWay}" Width="32" Height="32" />
            <TextBlock Text="Looking for OneDrive files that also take space on this PC…" Style="{StaticResource SecondaryTextStyle}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.RowSpan="4" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="440"
                    Visibility="{x:Bind Vm.IsEmpty, Mode=OneWay}">
            <FontIcon Glyph="&#xE73E;" FontSize="32" Foreground="{ThemeResource StatusSafeTextBrush}" Margin="0,0,0,8" />
            <TextBlock Text="Nothing to free up" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}" />
            <TextBlock Text="No file over 1 MB in OneDrive is both synced and kept on this PC. Files set to always stay on this device, and files still syncing, are left out."
                       Style="{StaticResource SecondaryTextStyle}" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Grid.Row="4" Text="No files match these filters." Style="{StaticResource SecondaryTextStyle}"
                   HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="{x:Bind Vm.NothingMatches, Mode=OneWay}" />
    </Grid>
</Page>
