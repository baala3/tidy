<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tidy.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <Grid>
            <StackPanel Padding="{StaticResource PagePadding}" Spacing="8" MaxWidth="{StaticResource PageMaxWidth}">
                <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,20" />

                <TextBlock Text="Appearance" Style="{StaticResource GroupHeaderStyle}" Margin="2,0,0,4" />
                <Border Style="{StaticResource CardStyle}" Padding="20,16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE790;" FontSize="20" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Theme" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Text="Follow Windows, or always use light or dark" Style="{StaticResource CaptionSecondaryStyle}" />
                        </StackPanel>
                        <ComboBox Grid.Column="2" x:Name="ThemeBox" MinWidth="160" SelectionChanged="OnThemeChanged" AutomationProperties.Name="Theme">
                            <x:String>Use system setting</x:String>
                            <x:String>Light</x:String>
                            <x:String>Dark</x:String>
                        </ComboBox>
                    </Grid>
                </Border>

                <TextBlock Text="Developer projects" Style="{StaticResource GroupHeaderStyle}" Margin="2,20,0,4" />
                <Border Style="{StaticResource CardStyle}" Padding="20,16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE823;" FontSize="20" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Consider stale after" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionSecondaryStyle}"
                                       Text="Dev Tools lists a project's build and dependency folders only once nothing in the project has changed for this long, including git activity. A project with a terminal or dev server running inside it never appears." />
                        </StackPanel>
                        <ComboBox Grid.Column="2" x:Name="StaleBox" MinWidth="160" SelectionChanged="OnStaleChanged" AutomationProperties.Name="Consider stale after">
                            <x:String>1 month</x:String>
                            <x:String>3 months</x:String>
                            <x:String>6 months</x:String>
                            <x:String>12 months</x:String>
                            <x:String>2 years</x:String>
                            <x:String>Show all</x:String>
                        </ComboBox>
                    </Grid>
                </Border>

                <TextBlock Text="Safety" Style="{StaticResource GroupHeaderStyle}" Margin="2,20,0,4" />
                <Border Style="{StaticResource CardStyle}" Padding="20,16">
                    <StackPanel Spacing="10">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextPrimaryBrush}"
                                   Text="Everything Tidy removes goes to the Recycle Bin, so it can come back. If the Recycle Bin is turned off for a drive, or an item is too big for it, Tidy leaves that item alone rather than delete it for good. The one exception is the Windows page: Windows' own Disk Cleanup removes those files for good, and Windows asks for permission first." />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionSecondaryStyle}"
                                   Text="Tidy only shows folders it knows about. Each path is checked again against its safety rules at the moment it is moved, and anything behind a link or junction is skipped." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
