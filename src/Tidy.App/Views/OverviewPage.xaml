<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tidy.App.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="0" MaxWidth="{StaticResource PageMaxWidth}">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Overview" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock x:Name="ScannedText" Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0" />
                </StackPanel>
                <Button x:Name="ScanAllButton" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="OnScanEverything" AutomationProperties.Name="Scan Everything" ToolTipService.ToolTip="Scan every category (Ctrl+Shift+R)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Grid Width="16" Height="16">
                            <FontIcon x:Name="ScanIcon" Glyph="&#xE72C;" FontSize="14" />
                            <ProgressRing x:Name="ScanRing" Width="16" Height="16" Foreground="{ThemeResource TextPrimaryBrush}" />
                        </Grid>
                        <TextBlock x:Name="ScanAllText" Text="Scan Everything" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Margin="0,28,0,0">
                <TextBlock VerticalAlignment="Bottom">
                    <Run x:Name="UsedText" FontSize="40" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                    <Run x:Name="TotalText" FontSize="18" Foreground="{ThemeResource TextSecondaryBrush}" />
                </TextBlock>
                <TextBlock x:Name="FreeText" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,8"
                           FontSize="18" Foreground="{ThemeResource TextSecondaryBrush}" />
            </Grid>

            <Grid x:Name="Bar" Height="14" Margin="0,14,0,0" ColumnSpacing="3" />

            <Border Style="{StaticResource CardStyle}" Margin="0,32,0,0">
                <StackPanel x:Name="CategoryRows" />
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0">
                <StackPanel x:Name="OtherRows" />
            </Border>

            <Grid Margin="0,24,0,0" ColumnSpacing="12" x:Name="RecycleNote">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="RecycleText" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <HyperlinkButton Grid.Column="1" Content="Open Recycle Bin" Click="OnOpenRecycleBin" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
