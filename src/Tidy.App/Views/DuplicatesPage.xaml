<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tidy.App.Views.DuplicatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Tidy.App.ViewModels"
    xmlns:core="using:Tidy.Core.Deletion">
    <Page.Resources>
        <CollectionViewSource x:Name="GroupedCopies" IsSourceGrouped="True" />
    </Page.Resources>

    <Grid Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Duplicates" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{x:Bind Vm.Summary, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button Style="{StaticResource SecondaryButtonStyle}" Click="OnScan" IsEnabled="{x:Bind Not(Vm.IsBusy), Mode=OneWay}"
                        ToolTipService.ToolTip="Scan again (Ctrl+R)" AutomationProperties.Name="Scan">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="R" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Grid Width="16" Height="16">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" Visibility="{x:Bind Collapsed(Vm.IsScanning), Mode=OneWay}" />
                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind Vm.IsScanning, Mode=OneWay}"
                                          Foreground="{ThemeResource TextPrimaryBrush}" />
                        </Grid>
                        <TextBlock Text="Scan" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButtonStyle}" Click="OnRecycle" IsEnabled="{x:Bind Vm.CanRecycle, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind Vm.RecycleButtonText, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Grid Width="16" Height="16">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" Visibility="{x:Bind Collapsed(Vm.IsCleaning), Mode=OneWay}" />
                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind Vm.IsCleaning, Mode=OneWay}"
                                          Foreground="{ThemeResource OnActionPrimaryBrush}" />
                        </Grid>
                        <TextBlock Text="{x:Bind Vm.RecycleButtonText, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,20,0,0" ColumnSpacing="8" Visibility="{x:Bind Vm.HasGroups, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="360" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox PlaceholderText="Search by name or folder" QueryIcon="Find"
                            Text="{x:Bind Vm.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="Search duplicates" />
            <ComboBox Grid.Column="2" x:Name="SortBox" MinWidth="150" SelectionChanged="OnSortChanged" AutomationProperties.Name="Sort by" />
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,14,0,10" Spacing="4" Visibility="{x:Bind Vm.HasGroups, Mode=OneWay}">
            <CheckBox x:Name="SelectExtras" Content="Select extra copies" MinWidth="0"
                      IsChecked="{x:Bind Vm.SelectExtrasState, Mode=OneWay}" Click="OnSelectExtras" />
            <TextBlock Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap"
                       Text="Picks every copy except the one marked Keep. One copy of each file always stays where it is." />
        </StackPanel>

        <InfoBar Grid.Row="3" Margin="0,0,0,10" IsOpen="{x:Bind Vm.IsResultOpen, Mode=TwoWay}"
                 Title="{x:Bind Vm.ResultTitle, Mode=OneWay}" Message="{x:Bind Vm.ResultMessage, Mode=OneWay}"
                 Severity="{x:Bind ResultSeverity(Vm.ResultHasFailures), Mode=OneWay}">
            <InfoBar.ActionButton>
                <HyperlinkButton Content="Open Recycle Bin" Click="OnOpenRecycleBin" />
            </InfoBar.ActionButton>
            <ItemsControl ItemsSource="{x:Bind Vm.ResultFailures}" Margin="0,0,0,12" Visibility="{x:Bind Vm.ResultHasFailures, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:CleanFailure">
                        <StackPanel Margin="0,2">
                            <TextBlock Text="{x:Bind Path}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Reason}" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </InfoBar>

        <ListView Grid.Row="4" ItemsSource="{x:Bind GroupedCopies.View, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True"
                  ItemClick="OnItemClick" Padding="0,0,0,24" Margin="-12,0,-12,0">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource CardListViewItemStyle}" />
            </ListView.ItemContainerStyle>
            <ListView.GroupStyle>
                <GroupStyle HidesIfEmpty="True">
                    <GroupStyle.HeaderContainerStyle>
                        <Style TargetType="ListViewHeaderItem">
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="12,0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewHeaderItem">
                                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Stretch" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.HeaderContainerStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="vm:DuplicateGroupViewModel">
                            <StackPanel Margin="2,14,0,8">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Foreground="{ThemeResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionSecondaryStyle}" />
                            </StackPanel>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:DuplicateCopyViewModel">
                    <Grid ColumnSpacing="14" Background="Transparent" ToolTipService.ToolTip="{x:Bind Path}" DoubleTapped="OnRowDoubleTapped">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Open" Tag="{x:Bind}" Click="OnOpen">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8E5;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Show in File Explorer" Tag="{x:Bind}" Click="OnShowInExplorer">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B7;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Copy path" Tag="{x:Bind}" Click="OnCopyPath">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=OneWay}" IsEnabled="{x:Bind CanSelect, Mode=OneWay}" Tag="{x:Bind}" Click="OnRowCheckClick"
                                  MinWidth="0" Padding="0" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind Path}"
                                  ToolTipService.ToolTip="{x:Bind CheckTooltip, Mode=OneWay}" />
                        <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8" Background="{ThemeResource FillSecondaryBrush}">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource RowTitleStyle}" />
                                <Border Padding="7,1,7,2" CornerRadius="4" VerticalAlignment="Center" Visibility="{x:Bind IsSuggestedKeep}"
                                        Background="{ThemeResource StatusSafeFillBrush}" ToolTipService.ToolTip="Tidy's pick for the copy to keep">
                                    <TextBlock Text="Keep" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource StatusSafeTextBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionSecondaryStyle}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{x:Bind ModifiedText}" Style="{StaticResource CaptionSecondaryStyle}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="1" Grid.RowSpan="4" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="440"
                    Visibility="{x:Bind Vm.IsFirstScan, Mode=OneWay}">
            <ProgressRing IsActive="{x:Bind Vm.IsFirstScan, Mode=OneWay}" Width="32" Height="32" />
            <TextBlock Text="{x:Bind Vm.FirstScanText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.RowSpan="4" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="440"
                    Visibility="{x:Bind Vm.IsEmpty, Mode=OneWay}">
            <FontIcon Glyph="&#xE73E;" FontSize="32" Foreground="{ThemeResource StatusSafeTextBrush}" Margin="0,0,0,8" />
            <TextBlock Text="No duplicates" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}" />
            <TextBlock Text="No two files over 1 MB in Documents, Desktop, Downloads, Videos, Music or Pictures have the same contents."
                       Style="{StaticResource SecondaryTextStyle}" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Grid.Row="4" Text="No duplicates match your search." Style="{StaticResource SecondaryTextStyle}"
                   HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="{x:Bind Vm.NothingMatches, Mode=OneWay}" />
    </Grid>
</Page>
