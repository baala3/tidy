<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tidy.App.Views.CleanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Tidy.App.ViewModels"
    xmlns:core="using:Tidy.Core.Deletion"
    NavigationCacheMode="Disabled">
    <Page.Resources>
        <CollectionViewSource x:Name="GroupedItems" IsSourceGrouped="True" />

        <DataTemplate x:Key="RowTemplate" x:DataType="vm:ItemViewModel">
            <Grid ColumnSpacing="14" Background="Transparent"
                  ToolTipService.ToolTip="{x:Bind PathsTooltip, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Show in File Explorer" Tag="{x:Bind}" Click="OnShowInExplorer">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8B7;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Copy path" Tag="{x:Bind}" Click="OnCopyPath">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8C8;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>

                <CheckBox IsChecked="{x:Bind IsSelected, Mode=OneWay}" Tag="{x:Bind}" Click="OnRowCheckClick" IsEnabled="{x:Bind CanSelect, Mode=OneWay}"
                          MinWidth="0" Padding="0" VerticalAlignment="Center"
                          AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}" />
                <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8" VerticalAlignment="Center"
                        Background="{ThemeResource FillSecondaryBrush}">
                    <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="18" Foreground="{ThemeResource TextSecondaryBrush}" />
                </Border>
                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource RowTitleStyle}" />
                    <TextBlock Text="{x:Bind Explanation, Mode=OneWay}" Style="{StaticResource CaptionSecondaryStyle}"
                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind RestoreHint, Mode=OneWay}" Visibility="{x:Bind HasRestoreHint, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextTertiaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind IsBlocked, Mode=OneWay}" Margin="0,2,0,0">
                        <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource StatusDangerTextBrush}" />
                        <TextBlock Text="{x:Bind BlockedReason, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource StatusDangerTextBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="3" Spacing="6" VerticalAlignment="Center" MinWidth="96">
                    <TextBlock Text="{x:Bind SizeText, Mode=OneWay}" Style="{StaticResource SizeTextStyle}" />
                    <Border HorizontalAlignment="Right" Padding="7,2" CornerRadius="4" Visibility="{x:Bind IsSafe, Mode=OneWay}"
                            Background="{ThemeResource StatusSafeFillBrush}">
                        <TextBlock Text="Safe to Clean" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource StatusSafeTextBrush}" />
                    </Border>
                    <Border HorizontalAlignment="Right" Padding="7,2" CornerRadius="4" Visibility="{x:Bind IsCheckFirst, Mode=OneWay}"
                            Background="{ThemeResource StatusCheckFillBrush}">
                        <TextBlock Text="Check First" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource StatusCheckTextBrush}" />
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{x:Bind Vm.Title}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{x:Bind Vm.Summary, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button Style="{StaticResource SecondaryButtonStyle}" Click="OnScan" IsEnabled="{x:Bind CanScan(Vm.IsBusy), Mode=OneWay}"
                        ToolTipService.ToolTip="Scan again (Ctrl+R)" AutomationProperties.Name="Scan">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="R" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Grid Width="16" Height="16">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" Visibility="{x:Bind Collapsed(Vm.IsScanning), Mode=OneWay}" />
                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind Vm.IsScanning, Mode=OneWay}"
                                          Foreground="{ThemeResource TextPrimaryBrush}" />
                        </Grid>
                        <TextBlock Text="Scan" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButtonStyle}" Click="OnClean" IsEnabled="{x:Bind Vm.CanClean, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind Vm.CleanButtonText, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Grid Width="16" Height="16">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" Visibility="{x:Bind Collapsed(Vm.IsCleaning), Mode=OneWay}" />
                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind Vm.IsCleaning, Mode=OneWay}"
                                          Foreground="{ThemeResource OnActionPrimaryBrush}" />
                        </Grid>
                        <TextBlock Text="{x:Bind Vm.CleanButtonText, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,20,0,0" Visibility="{x:Bind Vm.HasItems, Mode=OneWay}">
            <ToggleButton Style="{StaticResource ChipStyle}" IsChecked="{x:Bind IsFilter(Vm.Filter, 0), Mode=OneWay}" Click="OnFilterAll">
                <TextBlock><Run Text="All" /><Run Text="  " /><Run Text="{x:Bind Vm.AllCount, Mode=OneWay}" Foreground="{ThemeResource TextTertiaryBrush}" /></TextBlock>
            </ToggleButton>
            <ToggleButton Style="{StaticResource ChipStyle}" IsChecked="{x:Bind IsFilter(Vm.Filter, 1), Mode=OneWay}" Click="OnFilterSafe">
                <TextBlock><Run Text="Safe to Clean" /><Run Text="  " /><Run Text="{x:Bind Vm.SafeCount, Mode=OneWay}" Foreground="{ThemeResource TextTertiaryBrush}" /></TextBlock>
            </ToggleButton>
            <ToggleButton Style="{StaticResource ChipStyle}" IsChecked="{x:Bind IsFilter(Vm.Filter, 2), Mode=OneWay}" Click="OnFilterCheckFirst">
                <TextBlock><Run Text="Check First" /><Run Text="  " /><Run Text="{x:Bind Vm.CheckFirstCount, Mode=OneWay}" Foreground="{ThemeResource TextTertiaryBrush}" /></TextBlock>
            </ToggleButton>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,14,0,10" ColumnSpacing="12" Visibility="{x:Bind Vm.HasItems, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="SelectAllSafe" Content="Select All Safe" IsThreeState="False" MinWidth="0"
                      IsChecked="{x:Bind Vm.SelectAllSafeState, Mode=OneWay}" IsEnabled="{x:Bind Vm.HasSafeItems, Mode=OneWay}"
                      Click="OnSelectAllSafe" />
            <HyperlinkButton Grid.Column="1" Content="{x:Bind Vm.AlsoSelectCheckFirstText, Mode=OneWay}"
                             Visibility="{x:Bind Vm.ShowAlsoSelectCheckFirst, Mode=OneWay}" Click="OnAlsoSelectCheckFirst"
                             Foreground="{ThemeResource TextSecondaryBrush}" Padding="4,2" />
            <ComboBox Grid.Column="2" x:Name="SortBox" MinWidth="130" SelectionChanged="OnSortChanged"
                      AutomationProperties.Name="Sort by">
                <x:String>Largest</x:String>
                <x:String>Newest</x:String>
                <x:String>Name</x:String>
            </ComboBox>
        </Grid>

        <InfoBar Grid.Row="3" Margin="0,0,0,10" IsOpen="{x:Bind Vm.IsResultOpen, Mode=TwoWay}"
                 Title="{x:Bind Vm.ResultTitle, Mode=OneWay}" Message="{x:Bind Vm.ResultMessage, Mode=OneWay}"
                 Severity="{x:Bind ResultSeverity(Vm.ResultHasFailures), Mode=OneWay}">
            <InfoBar.ActionButton>
                <HyperlinkButton Content="Open Recycle Bin" Click="OnOpenRecycleBin" />
            </InfoBar.ActionButton>
            <ItemsControl ItemsSource="{x:Bind Vm.ResultFailures}" Margin="0,0,0,12" Visibility="{x:Bind Vm.ResultHasFailures, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:CleanFailure">
                        <StackPanel Margin="0,2">
                            <TextBlock Text="{x:Bind Path}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Reason}" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </InfoBar>

        <ListView Grid.Row="4" x:Name="List" ItemsSource="{x:Bind GroupedItems.View, Mode=OneWay}"
                  ItemTemplate="{StaticResource RowTemplate}" SelectionMode="None" IsItemClickEnabled="True"
                  ItemClick="OnItemClick" Padding="0,0,0,24" Margin="-12,0,-12,0">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource CardListViewItemStyle}" />
            </ListView.ItemContainerStyle>
            <ListView.GroupStyle>
                <GroupStyle HidesIfEmpty="True">
                    <GroupStyle.HeaderContainerStyle>
                        <Style TargetType="ListViewHeaderItem">
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="12,0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewHeaderItem">
                                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Stretch" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.HeaderContainerStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="vm:ItemGroup">
                            <Grid Margin="2,14,0,8" Visibility="{x:Bind HasTitle}" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8F1;" FontSize="14" Foreground="{ThemeResource TextTertiaryBrush}"
                                          Visibility="{x:Bind IsProject}" VerticalAlignment="Top" Margin="0,3,0,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                               Foreground="{ThemeResource TextPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Subtitle}" Visibility="{x:Bind HasSubtitle}"
                                               Style="{StaticResource CaptionSecondaryStyle}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
        </ListView>

        <StackPanel Grid.Row="1" Grid.RowSpan="4" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                    Visibility="{x:Bind Vm.IsFirstScan, Mode=OneWay}">
            <ProgressRing IsActive="{x:Bind Vm.IsFirstScan, Mode=OneWay}" Width="32" Height="32" />
            <TextBlock Text="Looking for things that are safe to clean…" Style="{StaticResource SecondaryTextStyle}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.RowSpan="4" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="420"
                    Visibility="{x:Bind Vm.IsEmpty, Mode=OneWay}">
            <FontIcon Glyph="&#xE73E;" FontSize="32" Foreground="{ThemeResource StatusSafeTextBrush}" Margin="0,0,0,8" />
            <TextBlock Text="{x:Bind Vm.EmptyTitle}" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextPrimaryBrush}" />
            <TextBlock Text="{x:Bind Vm.EmptyMessage, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}"
                       TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
