<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tidy.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Tidy.App.ViewModels">
    <Grid Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="History" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Name="SummaryText" Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <TextBlock Grid.Row="1" Margin="0,20,0,14" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"
                   Text="Every clean, whether you ran it or Tidy ran it on your schedule. What went to the Recycle Bin can be put back from there until the Recycle Bin is emptied." />

        <ListView x:Name="Entries" Grid.Row="2" SelectionMode="None"
                  Padding="0,0,0,24" Margin="-12,0,-12,0" ItemContainerStyle="{StaticResource CardListViewItemStyle}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:HistoryEntryViewModel">
                    <Grid ColumnSpacing="14" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource FillSecondaryBrush}" VerticalAlignment="Top">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Text="{x:Bind Details}" Style="{StaticResource CaptionSecondaryStyle}" />
                            <TextBlock Text="{x:Bind ItemsText}" Style="{StaticResource CaptionSecondaryStyle}" Margin="0,4,0,0"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="{x:Bind ItemsMaxLines, Mode=OneWay}"
                                       IsTextSelectionEnabled="True" IsTextTrimmedChanged="OnItemsTrimmedChanged" />
                            <HyperlinkButton Content="{x:Bind ToggleText, Mode=OneWay}" Visibility="{x:Bind ShowsToggle, Mode=OneWay}"
                                             Click="OnToggleItems" Padding="0" Margin="0,2,0,0" FontSize="12" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" Style="{StaticResource SizeTextStyle}" VerticalAlignment="Top" MinWidth="80" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel x:Name="EmptyState" Grid.Row="2" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="420">
            <FontIcon Glyph="&#xE81C;" FontSize="32" Foreground="{ThemeResource TextTertiaryBrush}" />
            <TextBlock Text="Nothing cleaned yet" Style="{StaticResource RowTitleStyle}" HorizontalAlignment="Center" />
            <TextBlock Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" TextAlignment="Center"
                       Text="Cleans you run show up here, and so do automatic ones once you turn them on in Settings." />
        </StackPanel>
    </Grid>
</Page>
