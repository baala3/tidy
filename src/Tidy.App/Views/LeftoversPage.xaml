<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tidy.App.Views.LeftoversPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Tidy.App.ViewModels"
    xmlns:core="using:Tidy.Core.Deletion">
    <Grid Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Leftovers" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{x:Bind Vm.Summary, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button Style="{StaticResource SecondaryButtonStyle}" Click="OnScan" IsEnabled="{x:Bind Not(Vm.IsBusy), Mode=OneWay}"
                        ToolTipService.ToolTip="Scan again (Ctrl+R)" AutomationProperties.Name="Scan">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="R" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Grid Width="16" Height="16">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" Visibility="{x:Bind Collapsed(Vm.IsScanning), Mode=OneWay}" />
                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind Vm.IsScanning, Mode=OneWay}"
                                          Foreground="{ThemeResource TextPrimaryBrush}" />
                        </Grid>
                        <TextBlock Text="Scan" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButtonStyle}" Click="OnRecycle" IsEnabled="{x:Bind Vm.CanRecycle, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind Vm.RecycleButtonText, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Grid Width="16" Height="16">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" Visibility="{x:Bind Collapsed(Vm.IsCleaning), Mode=OneWay}" />
                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind Vm.IsCleaning, Mode=OneWay}"
                                          Foreground="{ThemeResource OnActionPrimaryBrush}" />
                        </Grid>
                        <TextBlock Text="{x:Bind Vm.RecycleButtonText, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,20,0,0" ColumnSpacing="8" Visibility="{x:Bind Vm.HasLeftovers, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ToggleButton Style="{StaticResource ChipStyle}" IsChecked="{x:Bind IsFilter(Vm.Filter, 0), Mode=OneWay}" Click="OnFilterAll">
                    <TextBlock><Run Text="All" /><Run Text="  " /><Run Text="{x:Bind Vm.AllCount, Mode=OneWay}" Foreground="{ThemeResource TextTertiaryBrush}" /></TextBlock>
                </ToggleButton>
                <ToggleButton Style="{StaticResource ChipStyle}" IsChecked="{x:Bind IsFilter(Vm.Filter, 1), Mode=OneWay}" Click="OnFilterJustRemoved"
                              Visibility="{x:Bind Vm.HasJustRemoved, Mode=OneWay}" ToolTipService.ToolTip="Apps you uninstalled from Tidy since it opened">
                    <TextBlock><Run Text="Just uninstalled" /><Run Text="  " /><Run Text="{x:Bind Vm.JustRemovedCount, Mode=OneWay}" Foreground="{ThemeResource TextTertiaryBrush}" /></TextBlock>
                </ToggleButton>
            </StackPanel>
            <AutoSuggestBox Grid.Column="1" PlaceholderText="Search by folder or app" QueryIcon="Find" MaxWidth="280" HorizontalAlignment="Right"
                            Text="{x:Bind Vm.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="Search leftovers" />
            <ComboBox Grid.Column="2" x:Name="SortBox" MinWidth="130" SelectionChanged="OnSortChanged" AutomationProperties.Name="Sort by" />
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,14,0,10" Spacing="4" Visibility="{x:Bind Vm.HasLeftovers, Mode=OneWay}">
            <CheckBox x:Name="SelectAll" Content="Select all" MinWidth="0" IsChecked="{x:Bind Vm.SelectAllState, Mode=OneWay}"
                      IsEnabled="{x:Bind Vm.CanSelectAll, Mode=OneWay}" Click="OnSelectAll" />
            <TextBlock Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap"
                       Text="Folders apps keep outside their install folder, still here after the app was removed. They can hold settings or files you made, so check each one." />
        </StackPanel>

        <InfoBar Grid.Row="3" Margin="0,0,0,10" IsOpen="{x:Bind Vm.IsResultOpen, Mode=TwoWay}"
                 Title="{x:Bind Vm.ResultTitle, Mode=OneWay}" Message="{x:Bind Vm.ResultMessage, Mode=OneWay}"
                 Severity="{x:Bind ResultSeverity(Vm.ResultHasFailures), Mode=OneWay}">
            <InfoBar.ActionButton>
                <HyperlinkButton Content="Open Recycle Bin" Click="OnOpenRecycleBin" />
            </InfoBar.ActionButton>
            <ItemsControl ItemsSource="{x:Bind Vm.ResultFailures}" Margin="0,0,0,12" Visibility="{x:Bind Vm.ResultHasFailures, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:CleanFailure">
                        <StackPanel Margin="0,2">
                            <TextBlock Text="{x:Bind Path}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Reason}" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </InfoBar>

        <ListView Grid.Row="4" ItemsSource="{x:Bind Vm.Visible}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick"
                  Padding="0,0,0,24" Margin="-12,0,-12,0" ItemContainerStyle="{StaticResource CardListViewItemStyle}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:LeftoverViewModel">
                    <Grid ColumnSpacing="14" Background="Transparent" ToolTipService.ToolTip="{x:Bind Path}" DoubleTapped="OnRowDoubleTapped">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Show in File Explorer" Tag="{x:Bind}" Click="OnShowInExplorer">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B7;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Copy path" Tag="{x:Bind}" Click="OnCopyPath">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=OneWay}" IsEnabled="{x:Bind CanSelect}" Tag="{x:Bind}" Click="OnRowCheckClick"
                                  MinWidth="0" Padding="0" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind Name}"
                                  ToolTipService.ToolTip="{x:Bind CheckTooltip}" />
                        <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8" Background="{ThemeResource FillSecondaryBrush}">
                            <FontIcon Glyph="&#xE8B7;" FontSize="18" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionSecondaryStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind EvidenceText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextTertiaryBrush}"
                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="6" MinWidth="110">
                            <TextBlock Text="{x:Bind SizeText}" Style="{StaticResource SizeTextStyle}" />
                            <Border HorizontalAlignment="Right" Padding="7,2" CornerRadius="4" Visibility="{x:Bind IsCheckFirst}"
                                    Background="{ThemeResource StatusCheckFillBrush}">
                                <TextBlock Text="Check First" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                                           Foreground="{ThemeResource StatusCheckTextBrush}" />
                            </Border>
                            <Border HorizontalAlignment="Right" Padding="7,2" CornerRadius="4" Visibility="{x:Bind NeedsAdministrator}"
                                    Background="{ThemeResource FillSecondaryBrush}">
                                <TextBlock Text="Needs administrator" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                            </Border>
                            <TextBlock Text="{x:Bind ModifiedText}" Style="{StaticResource CaptionSecondaryStyle}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="1" Grid.RowSpan="4" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                    Visibility="{x:Bind Vm.IsFirstScan, Mode=OneWay}">
            <ProgressRing IsActive="{x:Bind Vm.IsFirstScan, Mode=OneWay}" Width="32" Height="32" />
            <TextBlock Text="Looking for folders that removed apps left behind…" Style="{StaticResource SecondaryTextStyle}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.RowSpan="4" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="460"
                    Visibility="{x:Bind Vm.IsEmpty, Mode=OneWay}">
            <FontIcon Glyph="&#xE73E;" FontSize="32" Foreground="{ThemeResource StatusSafeTextBrush}" Margin="0,0,0,8" />
            <TextBlock Text="Nothing left behind" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}" />
            <TextBlock Text="Tidy found no folders in AppData, ProgramData or Program Files that it can tie to an app that's gone. A folder is listed only when Tidy can tell which app it came from."
                       Style="{StaticResource SecondaryTextStyle}" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Grid.Row="4" Text="No folders match." Style="{StaticResource SecondaryTextStyle}"
                   HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="{x:Bind Vm.NothingMatches, Mode=OneWay}" />
    </Grid>
</Page>
