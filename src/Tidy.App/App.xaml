                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#F4F2EF" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#EFEDEA" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#2E2D2B" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64625E" />
                    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#85827C" />
