                    <SolidColorBrush x:Key="ChartAppsTileBrush" Color="#D4691F" />
                    <SolidColorBrush x:Key="ChartOneDriveBrush" Color="#1FB386" />
                    <SolidColorBrush x:Key="ChartOneDriveTileBrush" Color="#159A72" />
                    <SolidColorBrush x:Key="ChartVirtualDisksBrush" Color="#D88BB6" />
                    <SolidColorBrush x:Key="ChartVirtualDisksTileBrush" Color="#B96A96" />
                    <SolidColorBrush x:Key="ChartWindowsBrush" Color="#F0E442" />
                    <SolidColorBrush x:Key="ChartWindowsTileBrush" Color="#A49612" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#2A2927" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#282725" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#ECEAE6" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A6A39D" />
                    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#807D78" />
                    <SolidColorBrush x:Key="SurfaceBaseBrush" Color="#171615" />
                    <SolidColorBrush x:Key="SurfaceCardBrush" Color="#1E1D1C" />
                    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#2B2A28" />
                    <SolidColorBrush x:Key="SurfaceCardHoverBrush" Color="#2A2927" />
                    <SolidColorBrush x:Key="FillSecondaryBrush" Color="#282725" />
                    <SolidColorBrush x:Key="FillSecondaryHoverBrush" Color="#2F2E2C" />
                    <SolidColorBrush x:Key="FillSecondaryPressedBrush" Color="#373533" />
                    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#302F2D" />
                    <SolidColorBrush x:Key="BorderStrongBrush" Color="#3D3B38" />
                    <SolidColorBrush x:Key="ActionPrimaryBrush" Color="#ECEAE6" />
                    <SolidColorBrush x:Key="ActionPrimaryHoverBrush" Color="#F6F4F1" />
                    <SolidColorBrush x:Key="ActionPrimaryPressedBrush" Color="#D8D5D0" />
                    <SolidColorBrush x:Key="OnActionPrimaryBrush" Color="#171615" />
                    <SolidColorBrush x:Key="ActionDestructiveBrush" Color="#D9372D" />
                    <SolidColorBrush x:Key="ActionDestructiveHoverBrush" Color="#E2453B" />
                    <SolidColorBrush x:Key="ActionDestructivePressedBrush" Color="#C4302A" />
                    <SolidColorBrush x:Key="StatusSafeTextBrush" Color="#5FD36B" />
                    <SolidColorBrush x:Key="StatusSafeFillBrush" Color="#1B2E22" />
                    <SolidColorBrush x:Key="StatusCheckTextBrush" Color="#F2B84B" />
                    <SolidColorBrush x:Key="StatusCheckFillBrush" Color="#332910" />
                    <SolidColorBrush x:Key="StatusDangerTextBrush" Color="#F47468" />
                    <SolidColorBrush x:Key="StatusDangerFillBrush" Color="#321B19" />
                    <SolidColorBrush x:Key="ChartAppCachesBrush" Color="#6CC3F0" />
                    <SolidColorBrush x:Key="ChartDevToolsBrush" Color="#3A94D0" />
                    <SolidColorBrush x:Key="ChartLargeFilesBrush" Color="#F0B020" />
                    <SolidColorBrush x:Key="ChartAppCachesTileBrush" Color="#3A9BD5" />
                    <SolidColorBrush x:Key="ChartDevToolsTileBrush" Color="#1E78BA" />
                    <SolidColorBrush x:Key="ChartLargeFilesTileBrush" Color="#D99A0B" />
                    <SolidColorBrush x:Key="ChartEverythingElseBrush" Color="#A8A49D" />
                    <SolidColorBrush x:Key="ChartFreeSpaceBrush" Color="#4E4B47" />
