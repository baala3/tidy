                    <SolidColorBrush x:Key="SurfaceCardBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SurfaceCardHoverBrush" Color="#F4F2EF" />
                    <SolidColorBrush x:Key="FillSecondaryBrush" Color="#EFEDEA" />
                    <SolidColorBrush x:Key="FillSecondaryHoverBrush" Color="#E8E6E2" />
                    <SolidColorBrush x:Key="FillSecondaryPressedBrush" Color="#DFDCD8" />
                    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E6E3DF" />
                    <SolidColorBrush x:Key="BorderStrongBrush" Color="#D5D2CD" />
                    <SolidColorBrush x:Key="ActionPrimaryBrush" Color="#353431" />
                    <SolidColorBrush x:Key="ActionPrimaryHoverBrush" Color="#42403D" />
                    <SolidColorBrush x:Key="ActionPrimaryPressedBrush" Color="#2A2927" />
                    <SolidColorBrush x:Key="OnActionPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ActionDestructiveBrush" Color="#D1312A" />
                    <SolidColorBrush x:Key="ActionDestructiveHoverBrush" Color="#BC2B25" />
                    <SolidColorBrush x:Key="ActionDestructivePressedBrush" Color="#A92620" />
                    <SolidColorBrush x:Key="StatusSafeTextBrush" Color="#1F7A35" />
                    <SolidColorBrush x:Key="StatusSafeFillBrush" Color="#E6F4EA" />
                    <SolidColorBrush x:Key="StatusCheckTextBrush" Color="#8A5300" />
                    <SolidColorBrush x:Key="StatusCheckFillBrush" Color="#FAEEDA" />
                    <SolidColorBrush x:Key="StatusDangerTextBrush" Color="#B4302A" />
                    <SolidColorBrush x:Key="StatusDangerFillBrush" Color="#FBE8E5" />
                    <SolidColorBrush x:Key="ChartAppCachesBrush" Color="#56B4E9" />
                    <SolidColorBrush x:Key="ChartDevToolsBrush" Color="#0072B2" />
                    <SolidColorBrush x:Key="ChartLargeFilesBrush" Color="#E69F00" />
                    <SolidColorBrush x:Key="ChartAppCachesTileBrush" Color="#3399D3" />
                    <SolidColorBrush x:Key="ChartDevToolsTileBrush" Color="#0072B2" />
                    <SolidColorBrush x:Key="ChartLargeFilesTileBrush" Color="#D18F00" />
                    <SolidColorBrush x:Key="ChartEverythingElseBrush" Color="#8C8983" />
                    <SolidColorBrush x:Key="ChartFreeSpaceBrush" Color="#DAD7D2" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
